{
  "name": "pinboard",
  "version": "0.1.0",
  "private": true,
  "description": "Pinned control plane: directory, placement, and HTTP proxy",
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ioredis": "^5.6.1",
    "undici": "^7.10.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
